# Port for the webhook + admin server
PORT=3100

# From Salla Partner Portal -> Webhooks -> Secret
SALLA_WEBHOOK_SECRET=

# Protects /qr and /admin/* endpoints. Use a long random string.
ADMIN_TOKEN=

# Default country code used when a customer mobile has no country prefix
DEFAULT_COUNTRY_CODE=966

# Max WhatsApp messages sent per calendar day (safety brake)
DAILY_LIMIT=40

# Do not send outside these hours (24h clock, TZ below)
QUIET_HOURS_START=22
QUIET_HOURS_END=9
TIMEZONE=Asia/Riyadh

# Set to 1 to log messages instead of actually sending them
DRY_RUN=0
